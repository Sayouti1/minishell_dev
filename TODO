minishell :)=> mkdir -p a/b/c
value --> [mkdir] | type ---> 0
value --> [-p] | type ---> 0
value --> [a/b/c] | type ---> 0

{
        command[1] = [mkdir],
        args = {
                [1] = [-p],
                [2] = [a/b/c],
        }
}

